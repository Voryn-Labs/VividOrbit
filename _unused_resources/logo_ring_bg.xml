<?xml version="1.0" encoding="utf-8"?>
<!-- Literal "orbit ring" around the live channel's logo - a gradient ring
     frame with the logo sitting inside it, tying the banner directly back
     to the app's own name rather than being an arbitrary decoration. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="@color/accent_indigo"
                android:endColor="@color/accent_cyan" />
        </shape>
    </item>
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/row_focus_bg" />
        </shape>
    </item>
</layer-list>

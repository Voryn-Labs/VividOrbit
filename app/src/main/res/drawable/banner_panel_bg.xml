<?xml version="1.0" encoding="utf-8"?>
<!-- Banner card background: dark gradient panel with a thin glowing gradient
     hairline along the top edge - reads like an edge-lit broadcast panel
     rather than a flat translucent rectangle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="@color/accent_indigo"
                android:endColor="@color/accent_cyan" />
        </shape>
    </item>
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="13dp"
                android:topRightRadius="13dp"
                android:bottomLeftRadius="16dp"
                android:bottomRightRadius="16dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/panel_gradient_top"
                android:endColor="@color/panel_gradient_bottom" />
        </shape>
    </item>
</layer-list>

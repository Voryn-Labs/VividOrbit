<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="0dp"
    android:paddingEnd="12dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/item_background_selector">

    <TextView
        android:id="@+id/settings_custom_number"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:includeFontPadding="false"
        android:background="@android:color/transparent"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:importantForAccessibility="no"
        android:text="1" />

    <ImageView
        android:id="@+id/settings_channel_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:importantForAccessibility="no">

        <TextView
            android:id="@+id/settings_channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:importantForAccessibility="no"
            android:text="Channel Name" />

        <TextView
            android:id="@+id/settings_dth_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:importantForAccessibility="no"
            android:text="DTH: 104" />
    </LinearLayout>

</LinearLayout>

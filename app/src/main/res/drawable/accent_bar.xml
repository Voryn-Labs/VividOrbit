<?xml version="1.0" encoding="utf-8"?>
<!-- Selection indicator used in both the category list and the audio track
     selector - same visual language as the row-selected accent bar, so the
     guide reads as one consistent system rather than several unrelated bits. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="3dp" />
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="@color/accent_indigo"
        android:endColor="@color/accent_cyan" />
</shape>

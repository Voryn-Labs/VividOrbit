<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/item_background_selector">

    <TextView
        android:id="@+id/settings_custom_number"
        android:layout_width="44dp"
        android:layout_height="30dp"
        android:gravity="center"
        android:background="@drawable/badge_number_bg"
        android:duplicateParentState="true"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/badge_number_text_color"
        android:textSize="14sp"
        android:text="1" />

    <ImageView
        android:id="@+id/settings_channel_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        android:contentDescription="Channel Logo"
        android:src="@android:drawable/ic_menu_slideshow" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settings_channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Channel Name" />

        <TextView
            android:id="@+id/settings_dth_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:text="DTH: 104" />
    </LinearLayout>

    <TextView
        android:id="@+id/settings_edit_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/btn_primary_normal"
        android:duplicateParentState="true"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:text="Edit" />

</LinearLayout>

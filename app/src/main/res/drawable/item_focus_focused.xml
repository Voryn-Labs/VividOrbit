<?xml version="1.0" encoding="utf-8"?>
<!-- Focused row: deliberately high-contrast - a thick off-white outline plus
     a noticeably lighter fill, so a D-pad user can never be in doubt about
     where they are, even at a glance from across the room. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="6dp" />
    <solid android:color="@color/row_focus_bg" />
    <stroke android:width="2dp" android:color="@color/text_primary" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Currently-playing row (not focused): subtle tinted fill + a gradient
     accent bar on the leading edge, so "what's on" reads at a glance
     without competing with the focus ring style above. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="0dp"
                android:bottomLeftRadius="0dp"
                android:topRightRadius="10dp"
                android:bottomRightRadius="10dp" />
            <solid android:color="@color/row_selected_bg" />
            <stroke android:width="1dp" android:color="@color/row_selected_border" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:gravity="left">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/accent_indigo"
                android:endColor="@color/accent_cyan" />
        </shape>
    </item>
</layer-list>
